{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/:path*.(jpg|jpeg|png|webp|svg|gif|woff|woff2|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://home.fordivine.com/",
      "permanent": true
    },
    {
      "source": "/assessment",
      "destination": "/assessment/",
      "permanent": false
    },
    {
      "source": "/crowned-authority-kickstart",
      "destination": "/crowned-authority-kickstart/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/assessment-dm",
      "destination": "https://fordivine-quiz.vercel.app/"
    },
    {
      "source": "/discover-dm",
      "destination": "/discover/"
    },
    {
      "source": "/assessment/",
      "destination": "https://fordivine-quiz.vercel.app/"
    },
    {
      "source": "/assessment/:path*",
      "destination": "https://fordivine-quiz.vercel.app/:path*"
    },
    {
      "source": "/crowned-authority-kickstart/",
      "destination": "https://fordivine-crowned-authority-kicksta.vercel.app/crowned-authority-kickstart/"
    },
    {
      "source": "/crowned-authority-kickstart/:path*",
      "destination": "https://fordivine-crowned-authority-kicksta.vercel.app/crowned-authority-kickstart/:path*"
    }
  ]
}
