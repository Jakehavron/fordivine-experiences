{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "https://home.fordivine.com/",
      "permanent": true
    },
    {
      "source": "/assessment",
      "destination": "/assessment/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/assessment-dm",
      "destination": "https://fordivine-quiz.vercel.app/?ref=patricia_dm"
    },
    {
      "source": "/discover-dm",
      "destination": "/discover/?ref=patricia_dm"
    },
    {
      "source": "/assessment/",
      "destination": "https://fordivine-quiz.vercel.app/"
    },
    {
      "source": "/assessment/:path*",
      "destination": "https://fordivine-quiz.vercel.app/:path*"
    }
  ]
}
